# separate repositories / external clones
PX4-Autopilot/
third_party/
# regenerable
.venv/
build/
__pycache__/
*.pyc
# simulation data and flight logs
logs/
# local settings
.claude/settings.local.json
# experiment result arrays (regenerable by each run.py; 13 MB)
experiments/**/*.npz
# casadi JIT build files
jit_tmp*.c
tmp_casadi_compiler_shell*
# flight logs (regenerable by fly.py; ~3 MB each)
experiments/**/results/fly_*.npy
